AWS_REGION=us-east-2
OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1
OPENAI_PROJECT_ID=default
MODEL_LARGE=openai.gpt-oss-120b
MODEL_SMALL=openai.gpt-oss-20b
# Password the UI sends as X-API-Key
API_KEY=
BUDGET_EMAIL=you@example.com
# Optional: Financial Datasets API (adds P/E and market cap); without it SEC XBRL is used
FINANCIAL_DATASETS_API_KEY=
TAVILY_API_KEY=
# SEC requires a contact: "Name app-name you@example.com"
SEC_USER_AGENT=
